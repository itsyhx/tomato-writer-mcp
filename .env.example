# ── 鉴权（必填）──────────────────────────────────────────────
# 浏览器登录番茄作家后台 → F12 → Network → 任选一个 /api/author/... 请求
# 1) 复制请求头里的完整 Cookie        → TOMATO_COOKIE
# 2) 复制请求头 X-Secsdk-Csrf-Token   → TOMATO_CSRF_TOKEN
TOMATO_COOKIE=
TOMATO_CSRF_TOKEN=

# ── 可选 ────────────────────────────────────────────────────
# 默认操作的书（book_id）。留空则用 switch_novel 选择，或自动取第一本。
TOMATO_DEFAULT_BOOK_ID=
